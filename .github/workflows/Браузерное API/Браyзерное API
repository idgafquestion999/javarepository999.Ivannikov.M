<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DOM задачи</title>
</head>
<body>
    <h1 id="title">Привет!</h1>

    <p>Первый параграф</p>
    <p>Второй параграф</p>
    <p>Третий параграф</p>

    <a id="link">Перейти</a>

    <p id="first-paragraph">Этот текст должен стать красным</p>

    <img id="image" src="https://via.placeholder.com/150" alt="картинка" width="150">

    <script>
        // 1. Изменение текста
        document.getElementById("title").textContent = "Добро пожаловать!";

        // 2. Подсчёт элементов
        let paragraphs = document.querySelectorAll("p");
        alert(`Количество параграфов: ${paragraphs.length}`);

        // 3. Изменение атрибутов
        let link = document.getElementById("link");
        link.href = "https://google.com";
        link.target = "_blank";

        // 4. Стилизация
        let firstP = document.getElementById("first-paragraph");
        firstP.style.color = "red";
        firstP.style.fontSize = "20px";

        // 5. Изменение картинки
        let img = document.getElementById("image");
        img.src = "https://via.placeholder.com/200";
    </script>
</body>
</html>
